{
  "name": "ai-hub-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "generate:api": "openapi-typescript http://127.0.0.1:3000/openapi.json -o src/apis/generated/portal.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.90.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.84.0",
    "react-arborist": "^3.4.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "6.30.4",
    "react-syntax-highlighter": "^15.6.6",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "18.19.130",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "jsdom": "26.1.0",
    "msw": "^2.12.0",
    "openapi-typescript": "^7.10.0",
    "tailwindcss": "4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "6.4.3",
    "vitest": "3.2.4"
  }
}
